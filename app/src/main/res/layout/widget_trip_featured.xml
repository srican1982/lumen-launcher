<?xml version="1.0" encoding="utf-8"?>
<!-- D · Wide featured trip -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trip_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_trip_glass_dark">

    <ImageView
        android:id="@+id/trip_widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_trip_scrim_strong" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/widget_ic_trip"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/trip_widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Trip Mode"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_medium"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/trip_widget_toggle"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:minWidth="40dp"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:background="@drawable/widget_trip_on_pill"
                android:text="ON"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/outfit_medium"
                android:includeFontPadding="false" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:id="@+id/trip_widget_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_medium"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/trip_widget_weather_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B8FFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/trip_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/outfit_semibold"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/trip_widget_dates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/trip_widget_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Discover. Capture. Relive."
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/trip_widget_stat_photos"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="54dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_trip_stat_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/outfit_medium"
                android:maxLines="2"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/trip_widget_stat_places"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="54dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/widget_trip_stat_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/outfit_medium"
                android:maxLines="2"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/trip_widget_stat_docs"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="54dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/widget_trip_stat_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/outfit_medium"
                android:maxLines="2"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/trip_widget_stats"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="54dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_trip_stat_circle"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/outfit_medium"
                android:maxLines="2"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/trip_widget_primary"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/widget_trip_cta_purple"
            android:gravity="center"
            android:text="Continue Trip  ›"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium"
            android:includeFontPadding="false" />
    </LinearLayout>
</FrameLayout>
