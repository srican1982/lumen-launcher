<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contact_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_contact_quick_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/widget_ic_contacts"
            android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/contact_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quick Contact"
                android:textColor="#F5F7FF"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_medium"
                android:maxLines="1"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/contact_card_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find. Call. Message."
                android:textColor="#B8C4D8"
                android:textSize="11sp"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>
        <ImageView
            android:id="@+id/contact_card_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_contact_button"
            android:src="@drawable/widget_contact_plus"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="Choose contacts" />
    </LinearLayout>

    <TextView
        android:id="@+id/contact_card_search"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:text="⌕  Search contacts…"
        android:textSize="13sp"
        android:textColor="#D8E0EC"
        android:background="@drawable/widget_contact_control"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">
        <LinearLayout android:id="@+id/contact_card_shortcut1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:id="@+id/contact_card_shortcut_icon1" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/widget_contact_button" android:src="@drawable/widget_contact_call" android:padding="11dp" android:scaleType="fitCenter" android:contentDescription="Shortcut" />
            <TextView android:id="@+id/contact_card_shortcut_label1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Call" android:textColor="#F5F7FF" android:textSize="10sp" android:fontFamily="@font/outfit_medium" android:gravity="center" android:maxLines="2" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/contact_card_shortcut2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:id="@+id/contact_card_shortcut_icon2" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/widget_contact_button" android:src="@drawable/widget_contact_call" android:padding="11dp" android:scaleType="fitCenter" android:contentDescription="Shortcut" />
            <TextView android:id="@+id/contact_card_shortcut_label2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Call" android:textColor="#F5F7FF" android:textSize="10sp" android:fontFamily="@font/outfit_medium" android:gravity="center" android:maxLines="2" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/contact_card_shortcut3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:id="@+id/contact_card_shortcut_icon3" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/widget_contact_message_button" android:src="@drawable/widget_contact_message" android:padding="11dp" android:scaleType="fitCenter" android:contentDescription="Shortcut" />
            <TextView android:id="@+id/contact_card_shortcut_label3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Message" android:textColor="#F5F7FF" android:textSize="10sp" android:fontFamily="@font/outfit_medium" android:gravity="center" android:maxLines="2" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/contact_card_shortcut4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:id="@+id/contact_card_shortcut_icon4" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/widget_contact_button" android:src="@drawable/widget_contact_call" android:padding="11dp" android:scaleType="fitCenter" android:contentDescription="Shortcut" />
            <TextView android:id="@+id/contact_card_shortcut_label4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Call" android:textColor="#F5F7FF" android:textSize="10sp" android:fontFamily="@font/outfit_medium" android:gravity="center" android:maxLines="2" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
