<?xml version="1.0" encoding="utf-8"?>
<!-- A · Clock + Weather -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_trip_glass_dark">

    <ImageView
        android:id="@+id/clock_widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/focus_evening_lake"
        android:contentDescription="@null" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_trip_scrim_strong" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/clock_widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/clock_widget_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:fontFamily="@font/outfit_semibold"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/clock_widget_weather_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀"
                android:textSize="18sp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/clock_widget_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:fontFamily="@font/outfit_semibold"
                android:includeFontPadding="false" />
        </LinearLayout>
        <TextView
            android:id="@+id/clock_widget_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/clock_widget_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@drawable/widget_clock_capsule">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/widget_clock_leaf"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/clock_widget_greeting"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@font/outfit_medium"
                android:maxLines="2"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
