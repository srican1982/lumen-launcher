<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_glass_dark_balanced">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_icon" android:layout_width="19dp" android:layout_height="19dp" android:contentDescription="@null" android:src="@drawable/widget_ic_traveldocs" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="@string/widget_traveldocs" android:textColor="#F6F5FA" android:textSize="12sp" android:fontFamily="@font/outfit_medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_action" android:layout_width="34dp" android:layout_height="26dp" android:gravity="center" android:text="@string/widget_more" android:textSize="19sp" android:textColor="#E4CB91" android:contentDescription="@string/widget_open" android:background="@drawable/widget_control" android:includeFontPadding="false" />
    </LinearLayout>
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/widget_preview_traveldocs_detail" android:textColor="#FFF8F1" android:textSize="13sp" android:fontFamily="@font/outfit_medium" android:maxLines="2" android:ellipsize="end" android:visibility="visible" android:includeFontPadding="false" />
    <Chronometer android:id="@+id/widget_timer" android:layout_width="match_parent" android:layout_height="24dp" android:textColor="#FFF8F1" android:textSize="20sp" android:fontFamily="@font/outfit_medium" android:visibility="gone" android:includeFontPadding="false" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#BCD0D8" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:text="@string/widget_preview_traveldocs_status" android:visibility="visible" android:includeFontPadding="false" />
    <LinearLayout android:id="@+id/widget_photos" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:id="@+id/widget_photo1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:scaleType="centerCrop" android:background="@drawable/widget_photo_frame" android:contentDescription="@string/widget_photo" android:visibility="gone" />
        <ImageView android:id="@+id/widget_photo2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:scaleType="centerCrop" android:background="@drawable/widget_photo_frame" android:contentDescription="@string/widget_photo" android:visibility="gone" />
        <ImageView android:id="@+id/widget_photo3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:scaleType="centerCrop" android:background="@drawable/widget_photo_frame" android:contentDescription="@string/widget_photo" android:visibility="gone" />
        <ImageView android:id="@+id/widget_photo4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginEnd="4dp" android:scaleType="centerCrop" android:background="@drawable/widget_photo_frame" android:contentDescription="@string/widget_photo" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_photo_names" android:layout_width="match_parent" android:layout_height="12dp" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/widget_person1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textColor="#BCD0D8" android:textSize="9sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_person2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textColor="#BCD0D8" android:textSize="9sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_person3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textColor="#BCD0D8" android:textSize="9sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_person4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textColor="#BCD0D8" android:textSize="9sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row1" android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/widget_check1" android:layout_width="34dp" android:layout_height="match_parent" android:text="@string/widget_circle" android:textColor="#E4CB91" android:textSize="22sp" android:gravity="center_vertical" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_task1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFF8F1" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row2" android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/widget_check2" android:layout_width="34dp" android:layout_height="match_parent" android:text="@string/widget_circle" android:textColor="#E4CB91" android:textSize="22sp" android:gravity="center_vertical" android:includeFontPadding="false" />
        <TextView android:id="@+id/widget_task2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFF8F1" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
    </LinearLayout>
    <TextView android:id="@+id/widget_button" android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#28251D" android:fontFamily="@font/outfit_medium" android:textSize="12sp" android:background="@drawable/widget_pill" android:visibility="visible" android:text="@string/widget_preview_traveldocs_button" android:includeFontPadding="false" />
    <ProgressBar android:id="@+id/widget_meter" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="8dp" android:max="100" android:progressTint="#E4CB91" android:progressBackgroundTint="#334E6C72" android:visibility="gone" style="?android:attr/progressBarStyleHorizontal" />
</LinearLayout>