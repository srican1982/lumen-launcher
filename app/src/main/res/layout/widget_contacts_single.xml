<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contact_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center_horizontal"
    android:background="@drawable/widget_contact_single_glass">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="8dp">
            <ImageView
                android:id="@+id/contact_card_photo1"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Contact" />
            <TextView
                android:id="@+id/contact_card_name1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#F5F7FF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit_medium"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/contact_card_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Favorite"
                android:textColor="#9AE6B4"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>
        <ImageView
            android:id="@+id/contact_card_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:background="@drawable/widget_contact_button"
            android:src="@drawable/widget_contact_plus"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="Choose contact" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/contact_card_extra"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">
        <ImageView
            android:id="@+id/contact_card_call1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="6dp"
            android:src="@drawable/widget_contact_call"
            android:background="@drawable/widget_contact_button"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="Call" />
        <ImageView
            android:id="@+id/contact_card_message1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="6dp"
            android:src="@drawable/widget_contact_message"
            android:background="@drawable/widget_contact_message_button"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="Message" />
        <ImageView
            android:id="@+id/contact_card_video"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="6dp"
            android:src="@drawable/widget_contact_video"
            android:background="@drawable/widget_contact_button"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="Video" />
        <ImageView
            android:id="@+id/contact_card_email"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="6dp"
            android:src="@drawable/widget_contact_email"
            android:background="@drawable/widget_contact_button"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="Email" />
    </LinearLayout>

    <TextView
        android:id="@+id/contact_card_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
