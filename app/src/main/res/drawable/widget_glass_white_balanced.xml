<?xml version="1.0" encoding="utf-8"?>
<!-- Balanced White Glass frost — cool gray translucent film. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#994A5260"
                android:centerColor="#A62A2F37"
                android:endColor="#B314171C" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#48FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
