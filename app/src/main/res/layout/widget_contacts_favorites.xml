<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contact_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_contact_dark_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/widget_ic_contacts"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/contact_card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Favorites"
            android:textColor="#F5F7FF"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />
        <ImageView
            android:id="@+id/contact_card_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_contact_button"
            android:src="@drawable/widget_contact_plus"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="Choose contacts" />
    </LinearLayout>

    <TextView
        android:id="@+id/contact_card_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tap to call or message"
        android:textColor="#B8C4D8"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">
            <LinearLayout
                android:id="@+id/contact_card_person1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/contact_card_photo1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="Contact" />
                <TextView
                    android:id="@+id/contact_card_name1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#F5F7FF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/contact_card_person2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/contact_card_photo2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="Contact" />
                <TextView
                    android:id="@+id/contact_card_name2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#F5F7FF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">
            <LinearLayout
                android:id="@+id/contact_card_person3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/contact_card_photo3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="Contact" />
                <TextView
                    android:id="@+id/contact_card_name3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#F5F7FF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/contact_card_person4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">
                <ImageView
                    android:id="@+id/contact_card_photo4"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="Contact" />
                <TextView
                    android:id="@+id/contact_card_name4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#F5F7FF"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
