<?xml version="1.0" encoding="utf-8"?>
<!-- Soft White Glass frost — cool gray airy film, borderless. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#664A5260"
                android:centerColor="#702A2F37"
                android:endColor="#7A14171C" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
