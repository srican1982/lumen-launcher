<?xml version="1.0" encoding="utf-8"?>
<!-- G · Travel docs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trip_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_trip_glass_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_ic_traveldocs"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/trip_widget_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Travel Docs"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_semibold"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/trip_widget_chevron"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/widget_trip_icon_circle"
            android:includeFontPadding="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:id="@+id/trip_widget_doc_row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/trip_widget_doc_icon1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:background="@drawable/widget_trip_doc_icon_blue"
                android:text="✈"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:includeFontPadding="false" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/trip_widget_doc_title1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/trip_widget_doc_sub1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/trip_widget_doc_row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/trip_widget_doc_icon2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:background="@drawable/widget_trip_doc_icon_muted"
                android:text="⌂"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:includeFontPadding="false" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/trip_widget_doc_title2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/trip_widget_doc_sub2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/trip_widget_doc_row3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/trip_widget_doc_icon3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:background="@drawable/widget_trip_doc_icon_muted"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:includeFontPadding="false" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/trip_widget_doc_title3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/trip_widget_doc_sub3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/trip_widget_doc_row4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/trip_widget_doc_icon4"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:background="@drawable/widget_trip_doc_icon_muted"
                android:text="◫"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:includeFontPadding="false" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/trip_widget_doc_title4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/trip_widget_doc_sub4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
