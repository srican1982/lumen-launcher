<?xml version="1.0" encoding="utf-8"?>
<!-- Soft Lumen violet frost — airy, borderless, matches in-app glass. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#663B1568"
                android:centerColor="#702E1060"
                android:endColor="#7A14061F" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#14E4C6FF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
