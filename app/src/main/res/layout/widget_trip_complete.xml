<?xml version="1.0" encoding="utf-8"?>
<!-- H · Trip complete -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trip_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_trip_glass_dark">

    <ImageView android:id="@+id/trip_widget_cover" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:contentDescription="@null" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_trip_scrim" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="22dp" android:layout_height="22dp" android:gravity="center"
                android:background="@drawable/widget_trip_icon_circle" android:text="✓" android:textColor="#4ADE80"
                android:textSize="12sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/trip_widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="Trip Complete" android:textColor="#FFFFFF"
                android:textSize="13sp" android:fontFamily="@font/outfit_medium" android:includeFontPadding="false" />
        </LinearLayout>

        <TextView android:id="@+id/trip_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="#FFFFFF" android:textSize="20sp"
            android:fontFamily="@font/outfit_semibold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <TextView android:id="@+id/trip_widget_dates" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#B8FFFFFF" android:textSize="11sp"
            android:maxLines="1" android:includeFontPadding="false" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp">
            <ImageView android:id="@+id/trip_widget_photo1" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:layout_marginEnd="4dp" android:scaleType="centerCrop"
                android:background="@drawable/widget_trip_photo_frame" android:contentDescription="Memory" />
            <ImageView android:id="@+id/trip_widget_photo2" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:layout_marginHorizontal="2dp" android:scaleType="centerCrop"
                android:background="@drawable/widget_trip_photo_frame" android:contentDescription="Memory" />
            <ImageView android:id="@+id/trip_widget_photo3" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:layout_marginHorizontal="2dp" android:scaleType="centerCrop"
                android:background="@drawable/widget_trip_photo_frame" android:contentDescription="Memory" />
            <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="4dp">
                <ImageView android:id="@+id/trip_widget_photo4" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="centerCrop" android:background="@drawable/widget_trip_photo_frame" android:contentDescription="More memories" />
                <TextView android:id="@+id/trip_widget_more" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:background="#88000000" android:textColor="#FFFFFF" android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium" android:visibility="gone" android:includeFontPadding="false" />
            </FrameLayout>
        </LinearLayout>

        <TextView android:id="@+id/trip_widget_stats" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="#D5DFF0" android:textSize="11sp"
            android:maxLines="2" android:includeFontPadding="false" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
            <TextView android:id="@+id/trip_widget_primary" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="34dp" android:layout_marginEnd="6dp" android:background="@drawable/widget_trip_cta_purple"
                android:gravity="center" android:text="View Album  ›" android:textColor="#FFFFFF"
                android:textSize="12sp" android:fontFamily="@font/outfit_medium" android:includeFontPadding="false" />
            <TextView android:id="@+id/trip_widget_share" android:layout_width="72dp" android:layout_height="34dp"
                android:background="@drawable/widget_trip_share_btn" android:gravity="center" android:text="Share"
                android:textColor="#FFFFFF" android:textSize="12sp" android:fontFamily="@font/outfit_medium"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
