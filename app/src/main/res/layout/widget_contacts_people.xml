<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contact_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_contact_people_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/widget_ic_contacts"
            android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/contact_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="People"
                android:textColor="#F5F7FF"
                android:textSize="16sp"
                android:fontFamily="@font/outfit_medium"
                android:maxLines="1"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/contact_card_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The important ones"
                android:textColor="#B8C4D8"
                android:textSize="11sp"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>
        <TextView
            android:id="@+id/contact_card_add_label"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Add +"
            android:textColor="#F5F7FF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium"
            android:background="@drawable/widget_contact_control"
            android:includeFontPadding="false" />
        <ImageView
            android:id="@+id/contact_card_add"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:contentDescription="Choose contacts" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">
        <LinearLayout android:id="@+id/contact_card_person1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="2dp">
            <ImageView android:id="@+id/contact_card_photo1" android:layout_width="52dp" android:layout_height="52dp" android:scaleType="centerCrop" android:contentDescription="Contact" />
            <TextView android:id="@+id/contact_card_name1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#F5F7FF" android:textSize="11sp" android:fontFamily="@font/outfit_medium" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/contact_card_person2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="2dp">
            <ImageView android:id="@+id/contact_card_photo2" android:layout_width="52dp" android:layout_height="52dp" android:scaleType="centerCrop" android:contentDescription="Contact" />
            <TextView android:id="@+id/contact_card_name2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#F5F7FF" android:textSize="11sp" android:fontFamily="@font/outfit_medium" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/contact_card_person3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="2dp">
            <ImageView android:id="@+id/contact_card_photo3" android:layout_width="52dp" android:layout_height="52dp" android:scaleType="centerCrop" android:contentDescription="Contact" />
            <TextView android:id="@+id/contact_card_name3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#F5F7FF" android:textSize="11sp" android:fontFamily="@font/outfit_medium" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/contact_card_person4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="2dp">
            <ImageView android:id="@+id/contact_card_photo4" android:layout_width="52dp" android:layout_height="52dp" android:scaleType="centerCrop" android:contentDescription="Contact" />
            <TextView android:id="@+id/contact_card_name4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#F5F7FF" android:textSize="11sp" android:fontFamily="@font/outfit_medium" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/contact_card_add_slot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="2dp">
            <ImageView android:id="@+id/contact_card_add_circle" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/widget_contact_plus" android:background="@drawable/widget_contact_button" android:padding="14dp" android:scaleType="fitCenter" android:contentDescription="Add contact" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Add" android:textColor="#B8C4D8" android:textSize="11sp" android:fontFamily="@font/outfit_medium" android:gravity="center" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
