<?xml version="1.0" encoding="utf-8"?>
<!-- B · Trip overview -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trip_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_trip_glass_dark">

    <ImageView
        android:id="@+id/trip_widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_trip_scrim_strong" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/trip_widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/outfit_semibold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/trip_widget_dates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
            <TextView
                android:id="@+id/trip_widget_chevron"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:background="@drawable/widget_trip_icon_circle"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:gravity="center">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/widget_trip_stat_circle"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/widget_trip_gold_camera"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/trip_widget_stat_photos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/outfit_medium"
                        android:gravity="center"
                        android:maxLines="2"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/widget_trip_stat_circle"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/widget_trip_gold_place"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/trip_widget_stat_places"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/outfit_medium"
                        android:gravity="center"
                        android:maxLines="2"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/widget_trip_stat_circle"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/widget_trip_gold_docs"
                        android:contentDescription="@null" />
                    <TextView
                        android:id="@+id/trip_widget_stat_docs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="@font/outfit_medium"
                        android:gravity="center"
                        android:maxLines="2"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/trip_widget_primary"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/widget_trip_cta_purple"
            android:gravity="center"
            android:text="Open Trip  ›"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/outfit_medium"
            android:includeFontPadding="false" />
    </LinearLayout>
</FrameLayout>
