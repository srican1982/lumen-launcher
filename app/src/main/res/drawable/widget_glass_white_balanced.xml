<?xml version="1.0" encoding="utf-8"?>
<!-- Same neutral frost as GlassColors; wallpaper supplies the color. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item><shape>
    <corners android:radius="26dp" />
    <gradient android:angle="270" android:startColor="#50FFFFFF" android:endColor="#32FFFFFF" />
    <stroke android:width="0.8dp" android:color="#66FFFFFF" />
</shape></item>
  <item><shape>
    <corners android:radius="26dp" />
    <gradient android:angle="315" android:startColor="#04FFFFFF" android:endColor="#00FFFFFF" />
  </shape></item>
</layer-list>
