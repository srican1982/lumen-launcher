<?xml version="1.0" encoding="utf-8"?>
<!-- Solid White Glass frost — deeper cool gray for busy wallpapers. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#E04A5260"
                android:centerColor="#E82A2F37"
                android:endColor="#F014171C" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#12FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
