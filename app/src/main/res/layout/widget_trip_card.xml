<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/trip_widget_root" android:clipToOutline="true" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_trip_card_background">
<ImageView android:id="@+id/trip_widget_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="Trip cover"/>
<ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_trip_scrim"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical">
<ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/widget_ic_trip" android:contentDescription="Trip"/>
<TextView android:id="@+id/trip_widget_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#BBD5FF" android:textSize="10sp" android:layout_marginStart="7dp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/trip_widget_toggle" android:background="@drawable/widget_trip_status" android:fontFamily="@font/outfit_medium" android:layout_width="40dp" android:layout_height="match_parent" android:textColor="#28251D" android:textSize="10sp" android:gravity="center"/>
</LinearLayout>
<TextView android:id="@+id/trip_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="@font/outfit_semibold" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
<TextView android:id="@+id/trip_widget_dates" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#D9E4FC" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/trip_widget_route" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C6D4EF" android:textSize="10sp" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/trip_widget_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="8dp" android:maxLines="1" android:ellipsize="end"/>
<LinearLayout android:id="@+id/trip_widget_previews" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="8dp"><ImageView android:id="@+id/trip_widget_photo1" android:rotation="-6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:scaleType="centerCrop" android:contentDescription="Trip photo 1" android:paddingVertical="4dp"/><ImageView android:id="@+id/trip_widget_photo2" android:rotation="0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:scaleType="centerCrop" android:contentDescription="Trip photo 2" android:paddingVertical="4dp"/><ImageView android:id="@+id/trip_widget_photo3" android:rotation="6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:scaleType="centerCrop" android:contentDescription="Trip photo 3" android:paddingVertical="4dp"/><ImageView android:id="@+id/trip_widget_photo4" android:rotation="0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:scaleType="centerCrop" android:contentDescription="Trip photo 4" android:paddingVertical="4dp"/></LinearLayout>
<LinearLayout android:id="@+id/trip_widget_actions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:visibility="gone"><TextView android:id="@+id/trip_widget_photo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Photo" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/><TextView android:id="@+id/trip_widget_place" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Place" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/><TextView android:id="@+id/trip_widget_note" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Note" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/><TextView android:id="@+id/trip_widget_docs" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="Docs" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/></LinearLayout>
<LinearLayout android:id="@+id/trip_widget_footer" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="8dp">
<TextView android:id="@+id/trip_widget_primary" android:fontFamily="@font/outfit_medium" android:paddingHorizontal="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/widget_trip_cta" android:textColor="#28251D" android:textSize="11sp" android:gravity="center" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/trip_widget_next" android:fontFamily="@font/outfit_medium" android:paddingHorizontal="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="@drawable/widget_trip_secondary" android:textColor="#F3D7A0" android:textSize="10sp" android:gravity="center" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout></LinearLayout></FrameLayout>